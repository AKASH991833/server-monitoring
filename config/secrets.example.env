# Copy this file to config/secrets.env and fill in real values.
# config/secrets.env is listed in .gitignore - never commit real credentials.

# --- Email alerts (uses the local `mail` command / MTA) ---
EMAIL_TO="you@example.com"
EMAIL_FROM="monitor@$(hostname)"

# --- Telegram alerts ---
# 1. Talk to @BotFather on Telegram, create a bot, copy the token.
# 2. Message your bot once, then read your chat id from:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
